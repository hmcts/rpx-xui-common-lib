  "scripts": {
    "sync:library-package": "node ./scripts/sync-library-package.mjs",
    "ng": "ng",
    "build:library": "ng build exui-common-lib --configuration production && node ./scripts/sync-library-package.mjs",
    "build:library:watch": "ng build exui-common-lib --configuration production --watch",
    "package": "cat dist/rpx-xui-common-lib/{runtime,polyfills,scripts,main}.js | gzip > elements.js.gz",
    "start": "ng serve -o",
    "start:no-open": "ng serve",
    "build": "ng build exui-common-lib && node ./scripts/sync-library-package.mjs",
    "build:dev": "ng build --watch exui-common-lib",
    "test": "ng test exui-common-lib",
    "test:e2e:typecheck": "tsc -p tsconfig.playwright.json --noEmit",
    "playwright": "./node_modules/.bin/playwright",
    "test:a11y": "playwright test -c playwright.accessibility.config.ts",
    "test:a11y:advisory": "node e2e/accessibility/run-advisory.cjs",
    "test:a11y:report": "node --test e2e/accessibility/*.test.cjs",
    "test:a11y:self-check": "playwright test -c e2e/accessibility/self-check/playwright.config.ts",
    "lint": "ng lint rpx-xui-common-lib",
    "e2e": "ng e2e"
  },
  "repository": {
    "type": "git",
